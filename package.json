{
  "name": "petshop-saas-api",
  "version": "0.1.0",
  "private": true,
  "description": "Generic multi-tenant petshop SaaS API built with NestJS, TypeORM and MySQL.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:local": "APP_ENV=local nest start --watch",
    "start:staging": "APP_ENV=staging node dist/main.js",
    "start:production": "APP_ENV=production node dist/main.js",
    "build:local": "APP_ENV=local nest build",
    "build:staging": "APP_ENV=staging nest build",
    "build:production": "APP_ENV=production nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "typeorm": "APP_ENV=local ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./data-source.ts",
    "typeorm:local": "APP_ENV=local ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./data-source.ts",
    "typeorm:staging": "APP_ENV=staging ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./data-source.ts",
    "typeorm:production": "APP_ENV=production ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d ./data-source.ts",
    "db:local:migration:run": "npm run typeorm:local -- migration:run",
    "db:local:migration:deploy": "npm run db:local:migration:run",
    "db:local:migration:revert": "npm run typeorm:local -- migration:revert",
    "db:local:migration:show": "npm run typeorm:local -- migration:show",
    "db:local:migration:status": "npm run db:local:migration:show",
    "db:local:migration:generate": "npm run typeorm:local -- migration:generate",
    "db:local:migration:create": "npm run typeorm:local -- migration:create",
    "db:local:schema:log": "npm run typeorm:local -- schema:log",
    "db:staging:migration:run": "npm run typeorm:staging -- migration:run",
    "db:staging:migration:deploy": "npm run db:staging:migration:run",
    "db:staging:migration:revert": "npm run typeorm:staging -- migration:revert",
    "db:staging:migration:show": "npm run typeorm:staging -- migration:show",
    "db:staging:migration:status": "npm run db:staging:migration:show",
    "db:staging:migration:generate": "npm run typeorm:staging -- migration:generate",
    "db:staging:migration:create": "npm run typeorm:staging -- migration:create",
    "db:staging:schema:log": "npm run typeorm:staging -- schema:log",
    "db:production:migration:run": "npm run typeorm:production -- migration:run",
    "db:production:migration:deploy": "npm run db:production:migration:run",
    "db:production:migration:revert": "npm run typeorm:production -- migration:revert",
    "db:production:migration:show": "npm run typeorm:production -- migration:show",
    "db:production:migration:status": "npm run db:production:migration:show",
    "db:production:migration:generate": "npm run typeorm:production -- migration:generate",
    "db:production:migration:create": "npm run typeorm:production -- migration:create",
    "db:production:schema:log": "npm run typeorm:production -- schema:log",
    "migration:run": "npm run db:local:migration:run",
    "migration:deploy": "npm run db:local:migration:deploy",
    "migration:revert": "npm run db:local:migration:revert",
    "migration:show": "npm run db:local:migration:show",
    "migration:status": "npm run db:local:migration:status",
    "migration:generate": "npm run db:local:migration:generate",
    "migration:create": "npm run db:local:migration:create"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/typeorm": "^11.0.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "mysql2": "^3.15.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^11.0.9",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^10.0.1",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
